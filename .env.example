# Glider B2B API v2 — get your key at https://console.glidercloud.dev/
GLIDER_API_KEY=

# Shared login gate for this app (see app.py's require_login) — set both
# to enable it. Leave either blank and the app blocks every visitor with
# a setup message instead of silently letting everyone in. On Streamlit
# Community Cloud, set these in the app's Secrets panel instead of a
# .env file — they're exposed as environment variables the same way.
APP_USERNAME=
APP_PASSWORD=
